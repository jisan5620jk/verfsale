   // Rank Searched keyword
   function normalize(str) {
  return (str || '')
    .toUpperCase()
    .replace(/\s+/g, '');
}

function rankColors(colors, search) {
  if (!search) return colors;

  const normalizedSearch = normalize(search);
  const words = search.toUpperCase().split(/\s+/).filter(Boolean);

  return colors
    .map(color => {
      const name = color.name || '';
      const normalizedName = normalize(name);

      let score = 100;

      // 1️⃣ Exact normalized match → TOP
      if (normalizedName === normalizedSearch) {
        score = 0;
      }
      // 2️⃣ Starts with
      else if (normalizedName.startsWith(normalizedSearch)) {
        score = 1;
      }
      // 3️⃣ All words exist
      else if (words.every(w => name.toUpperCase().includes(w))) {
        score = 2;
      }
      // 4️⃣ Partial match
      else if (words.some(w => name.toUpperCase().includes(w))) {
        score = 3;
      }

      return { ...color, _rank: score };
    })
    .sort((a, b) => a._rank - b._rank)
    .map(({ _rank, ...color }) => color); // cleanup
}
