<script>
   jQuery(document).ready(function(){

  function formatPagination(links) {
  const formatted = [];
  const pageLinks = links.filter(l => /^\d+$/.test(l.label)).map(l => ({
    ...l,
    page: parseInt(l.label),
  }));

  const prev = links.find(l => l.label.includes('Previous'));
  const next = links.find(l => l.label.includes('Next'));

  const current = pageLinks.find(l => l.active);
  if (!current) return links; // fallback if no active

  const currentPage = current.page;
  const lastPage = Math.max(...pageLinks.map(p => p.page));

  // Always include "Previous"
  if (prev) formatted.push(prev);

  // Always include first page
  const first = pageLinks.find(p => p.page === 1);
  if (first) formatted.push(first);

  if (currentPage > 4) {
    formatted.push({ url: null, label: '...', active: false });
  }

  // Include current ±2 range (excluding first/last if already shown)
  for (let i = currentPage - 2; i <= currentPage + 2; i++) {
    if (i > 1 && i < lastPage) {
      const found = pageLinks.find(p => p.page === i);
      if (found) formatted.push(found);
    }
  }

  if (currentPage < lastPage - 3) {
    formatted.push({ url: null, label: '...', active: false });
  }

  // Always include last page
  const last = pageLinks.find(p => p.page === lastPage);
  if (last) formatted.push(last);

  // Always include "Next"
  if (next) formatted.push(next);

  return formatted;
}

