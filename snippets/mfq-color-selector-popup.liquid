let suggestions = [];
async function GetSuggestions(q) {
    if (!q || q.length < 3) return;
    $('.suggestion_list').fadeOut(200)
    $('.suggestions_loader').fadeIn(200).css('display','flex')
    try {
        const res = await fetch(`https://olive-hamster-249045.hostingersite.com/api/test?q=${encodeURIComponent(q)}`);
        const data = await res.json();

        if(data.length > 0){
         suggestions = data;
         $('.suggestion_list').empty()
         data.forEach((d)=>{
           $('.suggestion_list').append(`<span name="${d.name}" class="suggestion_item" style="border-radius: 5px;padding: 5px 12px;cursor:pointer" >${d.name}</span>`)
         })

         $('.suggestion_list').fadeIn(200).css('display','flex')
         
        }
        $('.suggestions_loader').fadeOut(200)
        console.log(data);
    } catch (error) {
        console.error("Fetch error:", error);
        $('.suggestions_loader').fadeOut(200)
    }
}


