{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-grid-wrapper">
    <div class="section-{{ section.id }}-padding">
        <div class="color-grid-block page-width">
            {% for block in section.blocks %}
                <div class="color-grid-item">
                    <a href="{{ block.settings.link1 }}" class="cg-column cg-first" style="background-color:{{ block.settings.background-color1 }}; color:{{ block.settings.text-color1 }}">{{ block.settings.first-column }}</a>
                    <a href="{{ block.settings.link2 }}" class="cg-column cg-second" style="background-color:{{ block.settings.background-color2 }}; color:{{ block.settings.text-color2 }}">{{ block.settings.second-column }}</a>
                    <a href="{{ block.settings.link3 }}" class="cg-column cg-third" style="background-color:{{ block.settings.background-color3 }}; color:{{ block.settings.text-color3 }}">{{ block.settings.third-column }}</a>
                    <a href="{{ block.settings.link4 }}" class="cg-column cg-fourth" style="background-color:{{ block.settings.background-color4 }}; color:{{ block.settings.text-color4 }}">{{ block.settings.fourth-column }}</a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Color Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name":"row",
      "settings": [
        {
          "type": "header",
          "content": "First Column"
        },
        {
          "type": "text",
          "id": "first-column",
          "label": "First Column"
        },
        {
          "type": "color",
          "id": "background-color1",
          "label": "Background Color 1"
        },
        {
          "type": "color",
          "id": "text-color1",
          "label": "Text Color 1"
        },
        {
          "type": "url",
          "id": "link1",
          "label": "Link 1"
        },
        {
          "type": "header",
          "content": "Second Column"
        },
        {
          "type": "text",
          "id": "second-column",
          "label": "Second Column"
        },
        {
          "type": "color",
          "id": "background-color2",
          "label": "Background Color 2"
        },
        {
          "type": "color",
          "id": "text-color2",
          "label": "Text Color 2"
        },
        {
          "type": "url",
          "id": "link2",
          "label": "Link 2"
        },
        {
          "type": "header",
          "content": "Third Column"
        },
        {
          "type": "text",
          "id": "third-column",
          "label": "Third Column"
        },
        {
          "type": "color",
          "id": "background-color3",
          "label": "Background Color 3"
        },
        {
          "type": "color",
          "id": "text-color3",
          "label": "Text Color 3"
        },
        {
          "type": "url",
          "id": "link3",
          "label": "Link 3"
        },
        {
          "type": "header",
          "content": "Fourth Column"
        },
        {
          "type": "text",
          "id": "fourth-column",
          "label": "Fourth Column"
        },
        {
          "type": "color",
          "id": "background-color4",
          "label": "Background Color 4"
        },
        {
          "type": "color",
          "id": "text-color4",
          "label": "Text Color 4"
        },
        {
          "type": "url",
          "id": "link4",
          "label": "Link 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Color Grid"
    }
  ]
}
{% endschema %}