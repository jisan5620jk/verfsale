<script>
  (function() {
    const root = document.getElementById('sale-countdown-{{ section.id }}');
    if (!root) return;

    const hideWhenDone = root.getAttribute('data-hide-when-done') === 'true';

    // Get target date from Liquid
    {% if section.settings.use_metafield and template.name contains 'product' and product.metafields.custom.sale_end != blank %}
      var targetISO = "{{ product.metafields.custom.sale_end | date: "%Y-%m-%dT%H:%M:%SZ" }}";
    {% else %}
      var targetISO = "{{ section.settings.end_datetime }}";
    {% endif %}

    if (!targetISO || String(targetISO).trim() === '') {
      console.warn('Sale Countdown: No end date configured.');
      return;
    }

    const parsed = new Date(targetISO);
    if (isNaN(parsed.getTime())) {
      console.warn('Sale Countdown: Invalid date format →', targetISO);
      return;
    }

    const $days = root.querySelector('[data-days]');
    const $hours = root.querySelector('[data-hours]');
    const $minutes = root.querySelector('[data-minutes]');
    const $seconds = root.querySelector('[data-seconds]');
    const $expired = root.querySelector('[data-expired-msg]');
    const $timer = root.querySelector('.sale-countdown__timer');

    function pad(n){ return String(n).padStart(2, '0'); }

    function render(ms) {
      if (ms <= 0) {
        $days.textContent = '00';
        $hours.textContent = '00';
        $minutes.textContent = '00';
        $seconds.textContent = '00';
        if ($expired) $expired.hidden = false;
        if (hideWhenDone) root.hidden = true;
        if ($timer) $timer.setAttribute('aria-live', 'off');
        return true;
      }
      const totalSeconds = Math.floor(ms / 1000);
      const d = Math.floor(totalSeconds / 86400);
      const h = Math.floor((totalSeconds % 86400) / 3600);
      const m = Math.floor((totalSeconds % 3600) / 60);
      const s = totalSeconds % 60;
      $days.textContent = pad(d);
      $hours.textContent = pad(h);
      $minutes.textContent = pad(m);
      $seconds.textContent = pad(s);
      return false;
    }

    function tick() {
      const now = new Date();
      const ms = parsed - now;
      const done = render(ms);
      if (done) clearInterval(handle);
    }

    // Initial paint
    tick();
    const handle = setInterval(tick, 1000);

    document.addEventListener('visibilitychange', function(){
      if (!document.hidden) tick();
    });
  })();
</script>
<style>
    #sale-countdown-{{ section.id }} .sale-countdown__timer { display: inline-flex; align-items: center; gap: .75rem; font-variant-numeric: tabular-nums; }
    #sale-countdown-{{ section.id }} .sale-countdown__unit { display: grid; gap: .25rem; padding: .5rem .75rem; background: #f7f7f7; border-radius: .75rem; min-width: 64px;text-align:center; }
    #sale-countdown-{{ section.id }} .sale-countdown__value { font-size: clamp(1.5rem, 2.5vw + .5rem, 2.5rem); font-weight: 800; line-height: 1; color: #000;  }
    #sale-countdown-{{ section.id }} .sale-countdown__label { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: #000; }
    #sale-countdown-{{ section.id }} .sale-countdown__sep { font-size: clamp(1.25rem, 2vw + .25rem, 2rem); opacity: .5; color: #b90066; }
#sale-countdown-{{ section.id }} .button {
    background: #fff;
    border: 1px solid #d5d5d5;
    border-radius: 10px;
    opacity: 1;
    cursor: pointer;
    color: #b90066;
    font-weight: 600;
    /* font-family: "Open Sans", sans-serif; */
    letter-spacing: 0;
    font-size: 16px;
    transition: .3s all ease-in-out;
}
#sale-countdown-{{ section.id }} .button::after,#sale-countdown-{{ section.id }} .button::before {
    content:unset;
}
