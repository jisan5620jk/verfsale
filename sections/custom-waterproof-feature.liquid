{% comment %}
  Section: Waterproof Feature Split
  Fonts: Eigerdals (Heading), Maven Pro (Body)
  Constraints: No CSS Variables, No Dynamic CSS in Style tag.
{% endcomment %}

<!-- Import Google Font: Maven Pro -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Maven+Pro:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  /*
     Reset & Base Styles
     Note: 'Eigerdals' is a custom font. If not uploaded to the theme,
     it will fall back to the generic sans-serif.
  */

  .wp-feature-section {
    width: 100%;
    padding: 60px 20px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .wp-feature-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 40px;
  }

  /* Left Column: Content */
  .wp-feature-content {
    flex: 1;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #ffffff; /* Default text color */
  }

  /* Right Column: Image */
  .wp-feature-image-wrapper {
    flex: 1;
    min-width: 300px;
    position: relative;
    display: flex;
  }

  .wp-feature-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    display: block;
    min-height: 400px; /* Ensure height on mobile */
  }

  /* Typography & Elements */

  /* Badge */
  .wp-badge {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    background-color: rgba(30, 30, 60, 0.4);
    font-family: 'Maven Pro', sans-serif;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 25px;
    width: fit-content;
  }

  .wp-badge svg {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* Main Heading */
  .wp-heading {
    font-family: 'Eigerdals', 'Maven Pro', sans-serif; /* Fallback included */
    font-size: 48px;
    line-height: 1.1;
    font-weight: 700;
    margin: 0 0 25px 0;
  }

  /* Description Text */
  .wp-description {
    font-family: 'Maven Pro', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 35px 0;
    opacity: 0.9;
  }

  /* Highlight Box */
  .wp-highlight-box {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 30px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .wp-icon-circle {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 5px;
  }

  .wp-icon-circle svg {
    width: 16px;
    height: 16px;
    stroke: #ffffff;
    stroke-width: 2;
    fill: none;
  }

  .wp-box-content h3 {
    font-family: 'Eigerdals', 'Maven Pro', sans-serif;
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .wp-box-content p {
    font-family: 'Maven Pro', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.9;
  }

  /* Mobile Responsive */
  @media (max-width: 900px) {
    .wp-feature-container {
      flex-direction: column;
    }

    .wp-heading {
      font-size: 36px;
    }

    .wp-feature-image-wrapper {
      min-height: 300px;
    }
  }
</style>

<div class="wp-feature-section" style="background: {{ section.settings.bg_gradient }};">
  <div class="wp-feature-container">
    <!-- Left Column: Content -->
    <div class="wp-feature-content">
      <!-- Badge -->
      {% if section.settings.badge_text != blank %}
        <div class="wp-badge">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          {{ section.settings.badge_text }}
        </div>
      {% endif %}

      <!-- Main Heading -->
      <h2 class="wp-heading" style="color: {{ section.settings.text_color }};">
        {{ section.settings.heading }}
      </h2>

      <!-- Main Description -->
      <div class="wp-description" style="color: {{ section.settings.text_color }};">
        {{ section.settings.description }}
      </div>

      <!-- Highlight Box -->
      <div class="wp-highlight-box" style="background-color: {{ section.settings.box_bg_color }};">
        <div class="wp-icon-circle">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="wp-box-content">
          <h3 style="color: {{ section.settings.text_color }};">{{ section.settings.box_heading }}</h3>
          <p style="color: {{ section.settings.text_color }};">{{ section.settings.box_description }}</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Image -->
    <div class="wp-feature-image-wrapper">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', alt: section.settings.heading
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag }}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Waterproof Feature",
  "settings": [
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(135deg, #181d42 0%, #4a1c52 50%, #99005e 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Main Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Professional waterproofing solution"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main Heading",
      "default": "Are you looking for a waterproof floor solution for rising damp?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>In many older buildings, rising damp affects not only the walls but also the floors. Because exterior sealing is usually not possible, this must be done from the inside. However, a thick, multi-layered construction is often not an option, as it reduces the available ceiling height.</p>"
    },
    {
      "type": "header",
      "content": "Highlight Box Content"
    },
    {
      "type": "color",
      "id": "box_bg_color",
      "label": "Box Background Color",
      "default": "rgba(255, 255, 255, 0.1)",
      "info": "Use color picker opacity slider for transparency"
    },
    {
      "type": "text",
      "id": "box_heading",
      "label": "Box Heading",
      "default": "Remmers WP Flow easily solves this problem"
    },
    {
      "type": "textarea",
      "id": "box_description",
      "label": "Box Description",
      "default": "This innovative system combines sealing and leveling in a single layer. The floor is waterproofed and leveled in a single application."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    }
  ],
  "presets": [
    {
      "name": "Waterproof Feature"
    }
  ]
}
{% endschema %}
