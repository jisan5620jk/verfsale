{% comment %}
  Section: Sale Countdown Timer (Dynamic)
  Author: ChatGPT
  Usage:
    1) Save this as sections/sale-countdown-timer.liquid
    2) In the theme editor, add the section where you want the timer.
    3) Set an end date/time OR enable "Use product metafield" (requires a product template and metafield).

  Metafield option (optional):
    Namespace/key: custom.sale_end
    Type: Date and time
    Store values like: 2025-12-31T23:59:59

  Notes:
    - The timer auto-hides when finished (optional setting) or shows an expiry message.
    - No external JS libraries used. Accessible and responsive.
{% endcomment %}

<section
  id="sale-countdown-{{ section.id }}"
  class="sale-countdown"
  data-section-id="{{ section.id }}"
  data-hide-when-done="{{ section.settings.hide_when_done }}"
>
  <div class="sale-countdown__wrap">
    {% if section.settings.heading != blank %}
      <h2 class="sale-countdown__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="sale-countdown__subtext">{{ section.settings.subtext }}</p>
    {% endif %}

    <div class="sale-countdown__timer" role="timer" aria-live="polite">
      <div class="sale-countdown__unit">
        <span class="sale-countdown__value" data-days>00</span>
        <span class="sale-countdown__label">{{ section.settings.label_days }}</span>
      </div>
      <span class="sale-countdown__sep">{{ section.settings.separator }}</span>
      <div class="sale-countdown__unit">
        <span class="sale-countdown__value" data-hours>00</span>
        <span class="sale-countdown__label">{{ section.settings.label_hours }}</span>
      </div>
      <span class="sale-countdown__sep">{{ section.settings.separator }}</span>
      <div class="sale-countdown__unit">
        <span class="sale-countdown__value" data-minutes>00</span>
        <span class="sale-countdown__label">{{ section.settings.label_minutes }}</span>
      </div>
      <span class="sale-countdown__sep">{{ section.settings.separator }}</span>
      <div class="sale-countdown__unit">
        <span class="sale-countdown__value" data-seconds>00</span>
        <span class="sale-countdown__label">{{ section.settings.label_seconds }}</span>
      </div>
    </div>

    <p class="sale-countdown__expires" hidden data-expired-msg>
      {{ section.settings.expired_message }}
    </p>

    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <a class="sale-countdown__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>

  <style>
    #sale-countdown-{{ section.id }} {
      --bg: {{ section.settings.bg_color }};
      --fg: {{ section.settings.fg_color }};
      --accent: {{ section.settings.accent_color }};
      --muted: {{ section.settings.muted_color }};
      background: var(--bg);
      color: var(--fg);
      padding: {{ section.settings.padding_y }} {{ section.settings.padding_x }};
      border-radius: {{ section.settings.radius }};
      border: {{ section.settings.border_width }} solid {{ section.settings.border_color }};
      text-align: center;
    }
    #sale-countdown-{{ section.id }} .sale-countdown__wrap { max-width: {{ section.settings.max_width }}; margin: 0 auto; }
    #sale-countdown-{{ section.id }} .sale-countdown__heading { margin: 0 0 .25em; font-weight: 700; letter-spacing: .02em; }
    #sale-countdown-{{ section.id }} .sale-countdown__subtext { margin: 0 0 1rem; color: var(--muted); }

    #sale-countdown-{{ section.id }} .sale-countdown__timer { display: inline-flex; align-items: center; gap: .75rem; font-variant-numeric: tabular-nums; }
    #sale-countdown-{{ section.id }} .sale-countdown__unit { display: grid; gap: .25rem; padding: .5rem .75rem; background: color-mix(in srgb, var(--accent) 10%, transparent); border-radius: .75rem; min-width: 64px; }
    #sale-countdown-{{ section.id }} .sale-countdown__value { font-size: clamp(1.5rem, 2.5vw + .5rem, 2.5rem); font-weight: 800; line-height: 1; }
    #sale-countdown-{{ section.id }} .sale-countdown__label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
    #sale-countdown-{{ section.id }} .sale-countdown__sep { font-size: clamp(1.25rem, 2vw + .25rem, 2rem); opacity: .5; }

    #sale-countdown-{{ section.id }} .sale-countdown__expires { margin-top: 1rem; font-weight: 600; }

    #sale-countdown-{{ section.id }} .sale-countdown__cta { display: inline-block; margin-top: 1rem; padding: .75rem 1.25rem; border-radius: 1rem; text-decoration: none; background: var(--accent); color: var(--bg); font-weight: 700; box-shadow: 0 6px 14px rgba(0,0,0,.08); transition: transform .15s ease, opacity .15s ease; }
    #sale-countdown-{{ section.id }} .sale-countdown__cta:hover { transform: translateY(-1px); }

    @media (max-width: 480px) {
      #sale-countdown-{{ section.id }} .sale-countdown__unit { min-width: 56px; }
    }
  </style>

 <script>
  (function() {
    const root = document.getElementById('sale-countdown-{{ section.id }}');
    if (!root) return;

    const hideWhenDone = root.getAttribute('data-hide-when-done') === 'true';

    // Get target date from Liquid
    {% if section.settings.use_metafield and template.name contains 'product' and product.metafields.custom.sale_end != blank %}
      var targetISO = "{{ product.metafields.custom.sale_end | date: "%Y-%m-%dT%H:%M:%SZ" }}";
    {% else %}
      var targetISO = "{{ section.settings.end_datetime }}";
    {% endif %}

    if (!targetISO || String(targetISO).trim() === '') {
      console.warn('Sale Countdown: No end date configured.');
      return;
    }

    const parsed = new Date(targetISO);
    if (isNaN(parsed.getTime())) {
      console.warn('Sale Countdown: Invalid date format →', targetISO);
      return;
    }

    const $days = root.querySelector('[data-days]');
    const $hours = root.querySelector('[data-hours]');
    const $minutes = root.querySelector('[data-minutes]');
    const $seconds = root.querySelector('[data-seconds]');
    const $expired = root.querySelector('[data-expired-msg]');
    const $timer = root.querySelector('.sale-countdown__timer');

    function pad(n){ return String(n).padStart(2, '0'); }

    function render(ms) {
      if (ms <= 0) {
        $days.textContent = '00';
        $hours.textContent = '00';
        $minutes.textContent = '00';
        $seconds.textContent = '00';
        if ($expired) $expired.hidden = false;
        if (hideWhenDone) root.hidden = true;
        if ($timer) $timer.setAttribute('aria-live', 'off');
        return true;
      }
      const totalSeconds = Math.floor(ms / 1000);
      const d = Math.floor(totalSeconds / 86400);
      const h = Math.floor((totalSeconds % 86400) / 3600);
      const m = Math.floor((totalSeconds % 3600) / 60);
      const s = totalSeconds % 60;
      $days.textContent = pad(d);
      $hours.textContent = pad(h);
      $minutes.textContent = pad(m);
      $seconds.textContent = pad(s);
      return false;
    }

    function tick() {
      const now = new Date();
      const ms = parsed - now;
      const done = render(ms);
      if (done) clearInterval(handle);
    }

    // Initial paint
    tick();
    const handle = setInterval(tick, 1000);

    document.addEventListener('visibilitychange', function(){
      if (!document.hidden) tick();
    });
  })();
</script>

</section>

{% schema %}
{
  "name": "Sale Countdown Timer",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Limited-time Offer"},
    {"type": "text", "id": "subtext", "label": "Subtext", "default": "Hurry up! The deal ends soon."},

    {"type": "header", "content": "End date/time"},
    {"type": "checkbox", "id": "use_metafield", "label": "Use product metafield (custom.sale_end)", "default": false},
    {"type": "text", "id": "end_datetime", "label": "End date/time (ISO 8601)", "default": "2025-12-31T23:59:59", "info": "Example: 2025-12-31T23:59:59"},

    {"type": "header", "content": "Labels & messages"},
    {"type": "text", "id": "label_days", "label": "Label - Days", "default": "Days"},
    {"type": "text", "id": "label_hours", "label": "Label - Hours", "default": "Hours"},
    {"type": "text", "id": "label_minutes", "label": "Label - Minutes", "default": "Minutes"},
    {"type": "text", "id": "label_seconds", "label": "Label - Seconds", "default": "Seconds"},
    {"type": "text", "id": "separator", "label": "Separator", "default": ":"},
    {"type": "text", "id": "expired_message", "label": "Message after expiry", "default": "This offer has ended."},
    {"type": "checkbox", "id": "hide_when_done", "label": "Hide entire section when timer ends", "default": false},

    {"type": "header", "content": "CTA (optional)"},
    {"type": "text", "id": "cta_label", "label": "Button label", "default": "Shop now"},
    {"type": "url", "id": "cta_link", "label": "Button link"},

    {"type": "header", "content": "Design"},
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff"},
    {"type": "color", "id": "fg_color", "label": "Text color", "default": "#000000"},
    {"type": "color", "id": "accent_color", "label": "Accent", "default": "#000000"},
    {"type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b7280"},
    {"type": "color", "id": "border_color", "label": "Border color", "default": "#e5e7eb"},
    {"type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1},

    {"type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16},
    {"type": "text", "id": "max_width", "label": "Max width", "default": "900px"},
    {"type": "text", "id": "padding_x", "label": "Horizontal padding", "default": "1.25rem"},
    {"type": "text", "id": "padding_y", "label": "Vertical padding", "default": "1.25rem"}
  ],
  "presets": [
    {"name": "Sale countdown", "category": "Banners"}
  ]
}
{% endschema %}
