<div class="trust-badges__wrapper" style="padding-top: {{ section.settings.margin_top | default: 0 }}px; padding-bottom: {{ section.settings.margin_bottom | default: 0 }}px;">
  <div class="page-width page-width--narrow">
  <div class="trust-badges__grid trust-badges_slider">
    {% for block in section.blocks %}
      <div class="trust-badge">
          <span class="check-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#ba0066" viewBox="0 0 16 16">
              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
          </span>
        <span class="badge-text">
      {{ block.settings.before_text }}
          <span class="highlighted">{{ block.settings.highlight_text }}</span>
          {{ block.settings.after_text }}
        </span>
      </div>
    {% endfor %}
  </div>
 </div>
</div>

<script src="{{ 'slick.min.js' | asset_url }}"></script>
{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "trust-badges",
  "settings": [
{
  "type": "range",
  "id": "margin_top",
  "label": "Top margin (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 0
},
{
  "type": "range",
  "id": "margin_bottom",
  "label": "Bottom margin (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 0
}

    
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "before_text",
          "label": "Text before (black)"
        },
        {
          "type": "text",
          "id": "highlight_text",
          "label": "Highlight text (pink)"
        },
        {
          "type": "text",
          "id": "after_text",
          "label": "Text after (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "category": "Custom",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "before_text": "",
            "highlight_text": "Gratis verzending",
            "after_text": "vanaf €50"
          }
        },
        {
          "type": "badge",
          "settings": {
            "before_text": "Professionele",
            "highlight_text": "kwaliteit",
            "after_text": "cdcdc"
          }
        },
        {
          "type": "badge",
          "settings": {
            "before_text": "Altijd de",
            "highlight_text": "scherpste prijs",
            "after_text": "dcdcdc"
          }
        },
        {
          "type": "badge",
          "settings": {
            "before_text": "",
            "highlight_text": "Beoordeling 9.4",
            "after_text": "(webwinkelkeur)"
          }
        }
      ]
    }
  ]
}
{% endschema %}




<style>
.trust-badges__wrapper {
  padding: 1.5rem 0;
}

.trust-badges__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    align-items: flex-start;
}

.trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 15px;
    flex: 1 1 auto;
    justify-content: center;
    color: #000;
    text-align: center;
}

.check-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
    font-weight: 400;
    color: rgb(74, 74, 73);
    font-size: 15px;
    line-height: 1;
}

.highlighted {
	color: #ba0066;
	font-weight: 700;
	margin-left: 0.3rem;
	font-family: Assistant, sans-serif;
	line-height: 25px;
	font-size: 15px;
}
.check-icon svg {
	height: 16px;
}
  /* .trust-badge:last-child .check-icon {
    display: none;
} */
  .trust-badge:last-child span.highlighted {
    display: block;
}
@media screen and (max-width: 750px) {
  .trust-badges__grid {
    flex-direction: column;
    gap: 1rem;
  }
}
</style>
