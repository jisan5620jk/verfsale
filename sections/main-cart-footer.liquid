                  <style>
                    .cart__ctas {flex-wrap: wrap; justify-content: end;}
                    .cartthredesc p strong {color: #b90066;}
                  </style>

                  <script>
                    function toggleDiscountCode() {
                      const section = document.getElementById('discount-code-section');
                      section.style.display = section.style.display === 'none' ? 'block' : 'none';
                    }

                    function goToCheckout() {
                      const discount = document.getElementById('discount_code').value.trim();
                      // Redirect to /checkout or /cart?discount=CODE
                      const checkoutURL = discount ? `/checkout?discount=${encodeURIComponent(discount)}` : `/checkout`;

                      window.location.href = checkoutURL;
                    }
                  </script>
                </div>
              </div>

            {%- else -%}
              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}
      <div>
        <p>
          Bij meerdere producten met verschillende levertijden kan het zijn dat je bestelling in één keer wordt
          verstuurd.De leverdatum zal dan gebaseerd worden op het product met de langste levertijd.
        </p>
      </div>
