{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
<script>
  (function () {
    // ---- helpers
    function els() {
      return {
        bar: document.getElementById('free-shipping-bar-2'),
        msg: document.getElementById('free-shipping-message-2'),
        progress: document.getElementById('free-shipping-progress-2'),
      };
    }

    function getThreshold() {
      const { bar } = els();
      return bar ? Number(bar.dataset.threshold) : 0;
    }

    function currencySymbol() {
      const { bar } = els();
      return bar && bar.dataset.currency ? bar.dataset.currency : '€';
    }

    function refreshBar() {
      const { bar } = els();
      if (!bar) return; // bar might be inside a section that hasn't been rendered yet

      fetch('/cart.js')
        .then((r) => r.json())
        .then((cart) => {
          const { msg, progress } = els(); // re-select after possible re-render
          if (!msg || !progress) return;

          const threshold = getThreshold();
          const total = cart.total_price / 100;
          const percent = Math.min((total / threshold) * 100, 100);
          progress.style.width = percent + '%';

          if (total >= threshold) {
            msg.textContent = '🎉 U heeft GRATIS verzending ontgrendeld!';
          } else {
            const remaining = Math.max(0, threshold - total).toFixed(2);
            msg.textContent = `Spendeer ${currencySymbol()}${remaining} voor gratis verzending!`;
          }
        })
        .catch(() => {
          /* no-op */
        });
    }

    // ---- initial draw
    document.addEventListener('DOMContentLoaded', refreshBar);

    // ---- robust triggers after ANY cart change on the cart page
    // Dawn sometimes dispatches these (varies by version)
    document.addEventListener('cart:updated', refreshBar);
    document.addEventListener('cart:refresh', refreshBar);

    // Fallback: after cart form submits (qty +/- or remove use AJAX then re-render)
    document.addEventListener('submit', function (e) {
      if (e.target && e.target.closest('form[action^="/cart"]')) {
        setTimeout(refreshBar, 600);
      }
    });

    // Last-resort: watch the main content for section re-renders and re-draw
    const container = document.getElementById('MainContent') || document.body;
    const mo = new MutationObserver(() => {
      setTimeout(refreshBar, 0);
    });
    mo.observe(container, { childList: true, subtree: true });
  })();
</script>
